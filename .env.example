# Run `set -a; . ./.env; set +a` after copying this file to .env.
# Environment values are read by cogclaw/config.py; dotenv is not auto-loaded.
LOCAL_VLLM_URL=http://localhost:9500/v1
QWEN_BASE_URL=http://localhost:9500/v1
LOCAL_MODEL_CACHE=./models
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
LLAMA_API_KEY=
# Explicit DeepSeek route for new runs; historical runs used different IDs.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-v4-flash
# Gemini uses Google application default credentials, not a key in this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True
